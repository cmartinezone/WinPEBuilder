# =============================================================================
# WinPE Builder 2.0 — GitHub vs local
# =============================================================================
# Git cannot store empty folders. Pattern used below:
#   Folder/*          ignore everything inside
#   !Folder/.gitkeep  keep a marker so the folder is pushed
# Add-Scripts is NOT content-ignored — script files are shipped.
# =============================================================================

# --- Not shipped (local host prototypes) ---
# Engine is WinPE-Builder.ps1 only.
Tests/
UI/
Core/
backup/
.backup/

# --- Project folders: ignore contents, keep folder on GitHub ---
Add-Drivers/*
!Add-Drivers/.gitkeep

Add-Updates/*
!Add-Updates/.gitkeep

WinPE-ISO/*
!WinPE-ISO/.gitkeep

WinPE-Logs/*
!WinPE-Logs/.gitkeep

WinPE-Root/*
!WinPE-Root/.gitkeep

# Add-Scripts: track all content (startnet.cmd, tools, etc.)
# (no Add-Scripts/* rule)

# --- Build / media artifacts anywhere ---
*.iso
*.zip
*.wim

# --- Nested / local project workdirs ---
WinPE_amd64/
WinPE_x86/
WinPE_arm64/
test-pe/
test-winpe/
MyWinPE-Project/

# --- Logs by name (safety net; folder content already ignored above) ---
*.log

# --- Local helpers / editor ---
SetDirectories.ps1
Thumbs.db
Desktop.ini
*.psm1.bak
.vscode/
.vs/
.atl/
.opencode/
.codegraph/

# --- Test harness output ---
TestResults.xml
